# Postgres connection string. Host/port/db/credentials here are reused by the
# docker-compose Postgres service.
DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5433/portal

# Dedicated database for the automated test suite (backend/tests/db/). Same
# docker-compose Postgres service as DATABASE_URL, a different database; the
# suite provisions and migrates it itself. Never point this at the dev DB.
TEST_DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5433/service_portal_test

# Auth (used in a later stage)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / cookie settings (used in a later stage)
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
