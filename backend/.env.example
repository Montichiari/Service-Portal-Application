# Postgres connection string. Host/port/db/credentials here are reused by the
# docker-compose Postgres service.
DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5433/portal

# Dedicated database for the automated test suite (backend/tests/db/). Same
# docker-compose Postgres service as DATABASE_URL, a different database; the
# suite provisions and migrates it itself. Never point this at the dev DB.
TEST_DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5433/service_portal_test

# Auth. Token lifetimes (1 hr access / 30 day refresh) and cookie attributes
# are NOT configured here — they're contract constants in
# app/core/security.py. Only the signing secret and algorithm are
# environment-specific.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# The chat assistant (specs/chatbot/, Phase 5). All four are optional: with no
# ANTHROPIC_API_KEY the backend starts normally, serves every other route, and
# answers POST /chat/messages with a 500 — the assistant is off, nothing else
# is. Treat the key exactly like JWT_SECRET_KEY: real value in .env, which is
# gitignored, never here.
#
# ANTHROPIC_BASE_URL points at the Microsoft Foundry deployment this project
# was given (design.md decision 8). Leave it unset to talk to Anthropic
# directly with a Console key — the client picks its transport from whether
# this is set, so swapping providers is a line of config, not a code change.
ANTHROPIC_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
ANTHROPIC_API_KEY=your-api-key
# The only model deployed on that resource (design.md decision 1, revised).
ANTHROPIC_MODEL=claude-sonnet-5
# Ceiling on one reply. A chat widget's answers are short; this is sized for a
# paragraph plus a tool call, not for a document.
ANTHROPIC_MAX_TOKENS=2048
